# Copia este archivo como .env y completa los valores.
# El .env real NO se commitea (esta en .gitignore).

# Identificador de Google OAuth2 (IDaaS)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# URL base de la API Gateway de AWS (obligatorio por rubrica).
# Produccion (sitio desplegado en S3): etapa v2 de la API Gateway.
VITE_API_BASE_URL=https://offtc6ohih.execute-api.us-east-1.amazonaws.com/v2
# API key administrativa para escrituras del catalogo (POST/PUT/DELETE /api/productos)
# El valor debe coincidir con APP_ADMIN_API_KEY configurada en los microservicios.
VITE_ADMIN_API_KEY=md-2026-admin-key
# API key administrativa para escrituras del catalogo (POST/PUT/DELETE /api/productos)
# El valor debe coincidir con APP_ADMIN_API_KEY configurada en los microservicios.
VITE_ADMIN_API_KEY=md-2026-admin-key
# API key administrativa para escrituras del catalogo (POST/PUT/DELETE /api/productos)
# El valor debe coincidir con APP_ADMIN_API_KEY configurada en los microservicios.
VITE_ADMIN_API_KEY=md-2026-admin-key
# API key administrativa para escrituras del catalogo (POST/PUT/DELETE /api/productos)
# El valor debe coincidir con APP_ADMIN_API_KEY configurada en los microservicios.
VITE_ADMIN_API_KEY=md-2026-admin-key

# Para desarrollo local usa .env.development (el proxy de Vite enruta
# /api/* a los microservicios locales en localhost:5173).
